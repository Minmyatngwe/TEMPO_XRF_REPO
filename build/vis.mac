/run/initialize

/gps/particle gamma
/gps/energy 50 keV

/vis/open OGLSQt
/vis/drawVolume
/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge false
/vis/viewer/set/lineSegmentsPerCircle 100

# Global axes at world origin
/vis/scene/add/axes 0 0 0 30 mm

# Local axes at detector center
/vis/scene/add/localAxes detectorPhys 2

/vis/viewer/set/autoRefresh true
/vis/viewer/set/viewpointThetaPhi 70 30
/vis/viewer/zoom 20

/tracking/storeTrajectory 1
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate 10

/tracking/verbose 0
/run/beamOn 10

/vis/viewer/rebuild
/vis/viewer/flush